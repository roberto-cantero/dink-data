{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/roberto-cantero/dink-data/contracts/events.schema.json",
  "title": "DinkData game log (events.json)",
  "$comment": "Generated from src/dinkdata/contracts/ by `uv run dink contracts export`. Don't edit by hand. Rules JSON Schema can't express, such as ordering, ids and the score, are checked by the pydantic models.",
  "$defs": {
    "Bounce": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "bounce",
          "title": "Type",
          "type": "string"
        },
        "frame": {
          "description": "0-based index of a decoded frame.",
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        },
        "t": {
          "description": "Seconds from the first frame's timestamp.",
          "minimum": 0,
          "title": "T",
          "type": "number"
        },
        "image_xy": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "Pixels. null when out of frame.",
          "title": "Image Xy"
        },
        "court_xy": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "Feet (docs/COURT.md). null when not visible.",
          "title": "Court Xy"
        },
        "in": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "null when not visible.",
          "title": "In"
        },
        "close_call": {
          "title": "Close Call",
          "type": "boolean"
        },
        "conf": {
          "description": "Confidence, 0 to 1. Gold labels use 1.",
          "maximum": 1,
          "minimum": 0,
          "title": "Conf",
          "type": "number"
        }
      },
      "required": [
        "id",
        "type",
        "frame",
        "t",
        "image_xy",
        "court_xy",
        "in",
        "close_call",
        "conf"
      ],
      "title": "Bounce",
      "type": "object"
    },
    "Camera": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Opaque camera id (dinkdata.contracts.ids).",
          "pattern": "^c_[0-9a-f]{16}$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "description": "Calibration version in cameras/{id}/v{n}/.",
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "Camera",
      "type": "object"
    },
    "FinalScore": {
      "additionalProperties": false,
      "properties": {
        "A": {
          "minimum": 0,
          "title": "A",
          "type": "integer"
        },
        "B": {
          "minimum": 0,
          "title": "B",
          "type": "integer"
        }
      },
      "required": [
        "A",
        "B"
      ],
      "title": "FinalScore",
      "type": "object"
    },
    "Game": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "g1, g2, ... in time order.",
          "pattern": "^g[1-9][0-9]*$",
          "title": "Id",
          "type": "string"
        },
        "format": {
          "const": "sideout",
          "title": "Format",
          "type": "string"
        },
        "target": {
          "enum": [
            11,
            15,
            21
          ],
          "title": "Target",
          "type": "integer"
        },
        "finished": {
          "description": "false when the recording cut the game off.",
          "title": "Finished",
          "type": "boolean"
        },
        "winner_team": {
          "anyOf": [
            {
              "enum": [
                "A",
                "B"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Winner Team"
        },
        "final_score": {
          "$ref": "#/$defs/FinalScore"
        },
        "rallies": {
          "items": {
            "$ref": "#/$defs/Rally"
          },
          "title": "Rallies",
          "type": "array"
        }
      },
      "required": [
        "id",
        "format",
        "target",
        "finished",
        "winner_team",
        "final_score",
        "rallies"
      ],
      "title": "Game",
      "type": "object"
    },
    "Hit": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "hit",
          "title": "Type",
          "type": "string"
        },
        "frame": {
          "description": "0-based index of a decoded frame.",
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        },
        "t": {
          "description": "Seconds from the first frame's timestamp.",
          "minimum": 0,
          "title": "T",
          "type": "number"
        },
        "player": {
          "anyOf": [
            {
              "enum": [
                "p1",
                "p2",
                "p3",
                "p4"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "null when the hitter is unknown.",
          "title": "Player"
        },
        "shot_index": {
          "description": "1 is the serve, 2 the return.",
          "minimum": 1,
          "title": "Shot Index",
          "type": "integer"
        },
        "volley": {
          "title": "Volley",
          "type": "boolean"
        },
        "conf": {
          "description": "Confidence, 0 to 1. Gold labels use 1.",
          "maximum": 1,
          "minimum": 0,
          "title": "Conf",
          "type": "number"
        }
      },
      "required": [
        "id",
        "type",
        "frame",
        "t",
        "player",
        "shot_index",
        "volley",
        "conf"
      ],
      "title": "Hit",
      "type": "object"
    },
    "Net": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "net",
          "title": "Type",
          "type": "string"
        },
        "frame": {
          "description": "0-based index of a decoded frame.",
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        },
        "t": {
          "description": "Seconds from the first frame's timestamp.",
          "minimum": 0,
          "title": "T",
          "type": "number"
        },
        "conf": {
          "description": "Confidence, 0 to 1. Gold labels use 1.",
          "maximum": 1,
          "minimum": 0,
          "title": "Conf",
          "type": "number"
        }
      },
      "required": [
        "id",
        "type",
        "frame",
        "t",
        "conf"
      ],
      "title": "Net",
      "type": "object"
    },
    "Player": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "p1",
            "p2",
            "p3",
            "p4"
          ],
          "title": "Id",
          "type": "string"
        },
        "team": {
          "enum": [
            "A",
            "B"
          ],
          "title": "Team",
          "type": "string"
        },
        "label": {
          "description": "Generic, such as 'Player 1'.",
          "maxLength": 40,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "crop": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Path of the photo crop, or null if none.",
          "title": "Crop"
        }
      },
      "required": [
        "id",
        "team",
        "label",
        "crop"
      ],
      "title": "Player",
      "type": "object"
    },
    "Rally": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "g1_r1: game, then rally.",
          "pattern": "^g[1-9][0-9]*_r[1-9][0-9]*$",
          "title": "Id",
          "type": "string"
        },
        "start_t": {
          "description": "When the serve is hit.",
          "minimum": 0,
          "title": "Start T",
          "type": "number"
        },
        "end_t": {
          "description": "When the ball is dead.",
          "minimum": 0,
          "title": "End T",
          "type": "number"
        },
        "serve": {
          "$ref": "#/$defs/Serve"
        },
        "score_before": {
          "description": "Score call before the serve: serving team, receiving team, server number.",
          "pattern": "^[0-9]+-[0-9]+-[12]$",
          "title": "Score Before",
          "type": "string"
        },
        "winner_team": {
          "anyOf": [
            {
              "enum": [
                "A",
                "B"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "null when unknown, and for a replay.",
          "title": "Winner Team"
        },
        "replay": {
          "description": "The rally is replayed: same server, side and score.",
          "title": "Replay",
          "type": "boolean"
        },
        "rule_deviations": {
          "items": {
            "$ref": "#/$defs/RuleDeviation"
          },
          "title": "Rule Deviations",
          "type": "array"
        },
        "start_frame": {
          "description": "Frame of the serve.",
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "end_frame": {
          "description": "Frame when the ball is dead.",
          "minimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "winner_source": {
          "anyOf": [
            {
              "enum": [
                "serve_state",
                "ball",
                "label"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "null when winner_team is null.",
          "title": "Winner Source"
        },
        "end_reason": {
          "anyOf": [
            {
              "enum": [
                "net",
                "out",
                "double_bounce",
                "unreturned",
                "fault",
                "unexplained"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "null when unknown.",
          "title": "End Reason"
        },
        "reviewed": {
          "description": "true once a person has checked this rally.",
          "title": "Reviewed",
          "type": "boolean"
        },
        "conf": {
          "description": "Confidence, 0 to 1. Gold labels use 1.",
          "maximum": 1,
          "minimum": 0,
          "title": "Conf",
          "type": "number"
        },
        "events": {
          "items": {
            "discriminator": {
              "mapping": {
                "bounce": "#/$defs/Bounce",
                "hit": "#/$defs/Hit",
                "net": "#/$defs/Net"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Hit"
              },
              {
                "$ref": "#/$defs/Bounce"
              },
              {
                "$ref": "#/$defs/Net"
              }
            ]
          },
          "title": "Events",
          "type": "array"
        }
      },
      "required": [
        "id",
        "start_t",
        "end_t",
        "serve",
        "score_before",
        "winner_team",
        "replay",
        "rule_deviations",
        "start_frame",
        "end_frame",
        "winner_source",
        "end_reason",
        "reviewed",
        "conf",
        "events"
      ],
      "title": "Rally",
      "type": "object"
    },
    "RuleDeviation": {
      "additionalProperties": false,
      "description": "A rule break by the players (GLOSSARY: Rule deviation, ADR 0014).\n\nwrong_server: the right team and server number, but the other partner served.\nwrong_side: the right player served from the wrong side.\nextra_serve: the serving team lost as server 1 and served again at the same call.\nmissed_side_out: the serving team lost with server 2, or with the only server at 0-0-2,\nand kept the serve.\ngame_end_mismatch: the players stopped at a score that doesn't end the game, or played on\npast one. Only on a game's last rally.",
      "properties": {
        "type": {
          "enum": [
            "wrong_server",
            "wrong_side",
            "extra_serve",
            "missed_side_out",
            "game_end_mismatch"
          ],
          "title": "Type",
          "type": "string"
        },
        "conf": {
          "description": "Confidence, 0 to 1. Gold labels use 1.",
          "maximum": 1,
          "minimum": 0,
          "title": "Conf",
          "type": "number"
        }
      },
      "required": [
        "type",
        "conf"
      ],
      "title": "RuleDeviation",
      "type": "object"
    },
    "Segment": {
      "additionalProperties": false,
      "description": "A stretch of the recording with one game mode.",
      "properties": {
        "type": {
          "enum": [
            "game",
            "warmup",
            "drill",
            "idle"
          ],
          "title": "Type",
          "type": "string"
        },
        "start_frame": {
          "description": "0-based index of a decoded frame.",
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "end_frame": {
          "description": "0-based index of a decoded frame.",
          "minimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "start_t": {
          "description": "Seconds from the first frame's timestamp.",
          "minimum": 0,
          "title": "Start T",
          "type": "number"
        },
        "end_t": {
          "description": "Seconds from the first frame's timestamp.",
          "minimum": 0,
          "title": "End T",
          "type": "number"
        },
        "conf": {
          "description": "Confidence, 0 to 1. Gold labels use 1.",
          "maximum": 1,
          "minimum": 0,
          "title": "Conf",
          "type": "number"
        }
      },
      "required": [
        "type",
        "start_frame",
        "end_frame",
        "start_t",
        "end_t",
        "conf"
      ],
      "title": "Segment",
      "type": "object"
    },
    "Serve": {
      "additionalProperties": false,
      "description": "Who served, from where, and to whom. In gold labels `conf` is 1.",
      "properties": {
        "server": {
          "enum": [
            "p1",
            "p2",
            "p3",
            "p4"
          ],
          "title": "Server",
          "type": "string"
        },
        "server_number": {
          "description": "1 or 2, as played.",
          "enum": [
            1,
            2
          ],
          "title": "Server Number",
          "type": "integer"
        },
        "side": {
          "description": "The side of the court the server stood on.",
          "enum": [
            "left",
            "right"
          ],
          "title": "Side",
          "type": "string"
        },
        "receiver": {
          "anyOf": [
            {
              "enum": [
                "p1",
                "p2",
                "p3",
                "p4"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "null when not visible.",
          "title": "Receiver"
        },
        "conf": {
          "description": "Confidence, 0 to 1. Gold labels use 1.",
          "maximum": 1,
          "minimum": 0,
          "title": "Conf",
          "type": "number"
        }
      },
      "required": [
        "server",
        "server_number",
        "side",
        "receiver",
        "conf"
      ],
      "title": "Serve",
      "type": "object"
    },
    "Video": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Opaque video id (dinkdata.contracts.ids).",
          "pattern": "^v_[0-9a-f]{16}$",
          "title": "Id",
          "type": "string"
        },
        "fps_nominal": {
          "description": "The container's frame rate. Never use it for time.",
          "exclusiveMinimum": 0,
          "title": "Fps Nominal",
          "type": "number"
        },
        "frames": {
          "description": "Path of the video's frames.parquet.",
          "minLength": 1,
          "title": "Frames",
          "type": "string"
        },
        "dropped_frames": {
          "minimum": 0,
          "title": "Dropped Frames",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "fps_nominal",
        "frames",
        "dropped_frames"
      ],
      "title": "Video",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The game log of one recording. Rules JSON Schema can't express are checked in code.",
  "properties": {
    "schema": {
      "const": "dinkdata.events/v1",
      "title": "Schema",
      "type": "string"
    },
    "video": {
      "$ref": "#/$defs/Video"
    },
    "camera": {
      "$ref": "#/$defs/Camera"
    },
    "players": {
      "items": {
        "$ref": "#/$defs/Player"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Players",
      "type": "array"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/Segment"
      },
      "title": "Segments",
      "type": "array"
    },
    "games": {
      "items": {
        "$ref": "#/$defs/Game"
      },
      "title": "Games",
      "type": "array"
    }
  },
  "required": [
    "schema",
    "video",
    "camera",
    "players",
    "segments",
    "games"
  ],
  "type": "object"
}
