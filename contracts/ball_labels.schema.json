{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/roberto-cantero/dink-data/contracts/ball_labels.schema.json",
  "title": "DinkData ball clicks (ball_labels.parquet rows)",
  "$comment": "Generated from src/dinkdata/contracts/ by `uv run dink contracts export`. Don't edit by hand. Rules JSON Schema can't express, such as ordering, ids and the score, are checked by the pydantic models.",
  "$defs": {
    "BallLabelRow": {
      "additionalProperties": false,
      "description": "One row of ball_labels.parquet.",
      "properties": {
        "frame": {
          "description": "0-based index of a decoded frame.",
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        },
        "t": {
          "description": "Seconds from the first frame's timestamp.",
          "minimum": 0,
          "title": "T",
          "type": "number"
        },
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Pixels. null when not visible.",
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Pixels. null when not visible.",
          "title": "Y"
        },
        "visible": {
          "title": "Visible",
          "type": "boolean"
        },
        "clicked": {
          "description": "false for a frame CVAT interpolated between clicks.",
          "title": "Clicked",
          "type": "boolean"
        },
        "split": {
          "enum": [
            "train",
            "dev",
            "test"
          ],
          "title": "Split",
          "type": "string"
        }
      },
      "required": [
        "frame",
        "t",
        "x",
        "y",
        "visible",
        "clicked",
        "split"
      ],
      "title": "BallLabelRow",
      "type": "object"
    }
  },
  "items": {
    "$ref": "#/$defs/BallLabelRow"
  },
  "type": "array"
}
